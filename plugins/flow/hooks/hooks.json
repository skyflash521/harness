{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-git-write.py\"",
            "shell": "bash"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-approve-watchdog.py\" \"${CLAUDE_PLUGIN_ROOT}\"",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
