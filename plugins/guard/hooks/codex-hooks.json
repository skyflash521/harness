{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard-rm.py\" \"${PLUGIN_ROOT}\" --codex"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard-sed-inplace.py\" --codex"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard-time.py\" --codex"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard-root-scan.py\" --codex"
          }
        ]
      },
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/guard-delete-patch.py\""
          }
        ]
      }
    ]
  }
}
