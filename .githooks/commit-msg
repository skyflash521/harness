#!/usr/bin/env python3
"""commit-msg フック: シェル構文が漏れたコミットメッセージを拒否する。

次の失敗モードを捕捉する:

    git commit -m "$(cat <<'EOF' ... EOF )"

が展開されず(PowerShell で実行された / リテラルとして単一引用された等)、ヒアドキュメントの
テキストそのものがコミットメッセージになってしまうケース。この場合メッセージは `$(` で始まり、
`<<'EOF'` 等を含む。

ツール/シェル非依存: git は実際にどう発行されたコミットでも最終メッセージに対してこのフックを
実行するため、Bash 限定の PreToolUse ガード(guard-git-write.py)が届かない経路(PowerShell
ツール経由など)も保護できる。

拒否パターンはヒアドキュメント/コマンド置換漏れの曖昧でない痕跡だけに限定する。通常の日本語
コミットメッセージ(`$5` やバッククォートの `code` を含み得る)は決して拒否しない。

導入: core.hooksPath=.githooks で有効化する。
読み込めないメッセージファイルは通す。この種の便宜ガードで全コミットを止める方が実害が大きい。

自己テスト: python3 .githooks/commit-msg --selftest
"""
import re
import sys
from collections import namedtuple

HEREDOC = re.compile(r"<<-?(['\"]?)[A-Za-z_][A-Za-z0-9_]*\1")
CMDSUBST_FILE = re.compile(r"\$\(\s*cat[\s)]")


def malformed(message):
    """漏れたシェル構文に見えれば理由文字列を、問題なければ None を返す。"""
    # git の cleanup モードは経路で異なり、-m の既定は行頭 # の行を残す。
    if not message.strip():
        return None
    first = next((ln for ln in message.splitlines() if ln.strip()), "")
    if first.lstrip().startswith("$("):
        return "メッセージが `$(` で始まっています(コマンド置換が展開されずリテラル化した疑い)"
    if HEREDOC.search(message):
        return "ヒアドキュメント演算子(<<EOF 等)がメッセージに含まれています"
    if CMDSUBST_FILE.search(message):
        return "`$(cat ...)` がメッセージに含まれています(コマンド置換漏れの疑い)"
    return None


def main():
    if len(sys.argv) >= 2 and sys.argv[1] == "--selftest":
        selftest()
        return
    if len(sys.argv) < 2:
        return
    try:
        # i18n.commitEncoding によりメッセージは非 UTF-8 でありうる。検査パターンは ASCII。
        with open(sys.argv[1], encoding="utf-8", errors="replace") as handle:
            message = handle.read()
    except OSError:
        return
    reason = malformed(message)
    if reason:
        sys.stderr.write(
            "commit-msg フック: 不正なコミットメッセージを拒否しました。\n"
            "  理由: " + reason + "\n"
            "  コミットメッセージにシェル構文(ヒアドキュメント/コマンド置換)が混入しています。\n"
            "  単一の -m に単一引用で、展開済みの本文を渡してください。\n"
        )
        sys.exit(1)


def selftest():
    Case = namedtuple("Case", "why message")
    bad = [
        Case("ヒアドキュメントがそのまま件名になった形", "$(cat <<'EOF'\nmocapvmd: テスト追加\nEOF\n)"),
        Case("空白付きの区切り語を伴う漏れ", "$(cat << EOF\nx\nEOF\n)"),
        Case("本文にヒアドキュメントの開始が混入", "件名\n\n本文 <<'EOF' が混入"),
        Case("コマンド置換の cat", "$(cat foo)"),
        Case("裸のヒアドキュメント", "<<EOF\nx\nEOF"),
        Case("行頭が # でも検出する", "# メモ <<'EOF'"),
        Case("cat 以外のコマンド置換", "$(printf x)"),
        Case("本文中のコマンド置換", "件名\n\n本文 $(cat file)"),
    ]
    good = [
        Case("通常の日本語メッセージ", "mocapvmd: クリーニングプリセット解決のテストを追加"),
        Case("ドル記号とバッククォートと不等号を含む本文", "件名\n\n- コスト $5 を `code` で表現\n- a > b の比較"),
        Case("引用符を含む英語メッセージ", "fix: it's quoted \"text\""),
        Case("山括弧の対を含む見出し", "見出し<<重要>> な変更"),
        Case("空白付きの左シフト式", "perf: flags << SHIFT の左シフトを最適化"),
        Case("ビットシフトの記法", "1 << 8 のビットシフト修正"),
        Case("cat-file はコマンド置換の cat と区別する", "説明: $(cat-file -t HEAD) の出力を使う"),
        Case("行頭 # でもパターンが無ければ通す", "# 普通のメモ行\n本文だけの通常メッセージ"),
        Case("空メッセージ", ""),
    ]
    failures = []
    for case in bad:
        if malformed(case.message) is None:
            failures.append((f"不正のはずが pass ({case.why})", case.message))
    for case in good:
        reason = malformed(case.message)
        if reason is not None:
            failures.append((f"正常のはずが拒否 ({case.why}): " + reason, case.message))
    if failures:
        for why, message in failures:
            print("FAIL:", why, "::", repr(message))
        sys.exit(1)
    print(f"ALL PASS ({len(bad)} bad + {len(good)} good)")


if __name__ == "__main__":
    main()
